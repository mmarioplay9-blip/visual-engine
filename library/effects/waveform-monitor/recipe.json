{
  "id": "waveform-monitor",
  "name": "Waveform Monitor",
  "category": "hud",
  "summary": "Osciloscopio con onda compuesta, espectro de barras y lectura de pico; señal viva, no decorativa.",
  "tags": [
    "hud",
    "osciloscopio",
    "audio",
    "onda",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect waveform-monitor`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "label",
      "type": "string",
      "default": "SEÑAL / 440 HZ",
      "description": "Etiqueta del monitor"
    }
  ]
}
