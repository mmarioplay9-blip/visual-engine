{
  "id": "glass-refraction",
  "name": "Glass Refraction",
  "category": "materiales",
  "summary": "Panel de cristal que refracta bandas de color del fondo, con borde luminoso y sombra de contacto.",
  "tags": [
    "material",
    "cristal",
    "refraccion",
    "glass",
    "interfaz"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect glass-refraction`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "radius",
      "type": "number",
      "default": 24,
      "description": "Radio de las esquinas",
      "min": 2,
      "max": 48,
      "step": 1
    },
    {
      "name": "title",
      "type": "string",
      "default": "CRISTAL",
      "description": "Texto del panel"
    }
  ]
}
