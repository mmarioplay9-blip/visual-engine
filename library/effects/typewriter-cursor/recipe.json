{
  "id": "typewriter-cursor",
  "name": "Typewriter Cursor",
  "category": "tipografia",
  "summary": "Texto que se escribe carácter a carácter con cursor parpadeante, salto de línea y pausa; ritmo controlable.",
  "tags": [
    "tipografia",
    "maquina",
    "cursor",
    "texto",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect typewriter-cursor`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "title",
      "type": "string",
      "default": "La precisión también se ve.",
      "description": "Texto a escribir"
    },
    {
      "name": "kicker",
      "type": "string",
      "default": "> visual_engine --explain",
      "description": "Línea superior"
    },
    {
      "name": "cps",
      "type": "number",
      "default": 18,
      "description": "Caracteres por segundo",
      "min": 2,
      "max": 60,
      "step": 1
    }
  ]
}
