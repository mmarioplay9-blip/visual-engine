{
  "id": "volumetric-rays",
  "name": "Volumetric Rays",
  "category": "iluminacion",
  "summary": "Haces volumétricos desde una fuente fuera de cuadro, con polvo y desvanecimiento atmosférico.",
  "tags": [
    "iluminacion",
    "rayos",
    "volumetrico",
    "atmosfera",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect volumetric-rays`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "intensity",
      "type": "number",
      "default": 0.8,
      "description": "Potencia de los haces",
      "min": 0.2,
      "max": 1.4,
      "step": 0.05
    },
    {
      "name": "rays",
      "type": "number",
      "default": 22,
      "description": "Número de haces (referencia visual)",
      "min": 6,
      "max": 40,
      "step": 1
    }
  ]
}
