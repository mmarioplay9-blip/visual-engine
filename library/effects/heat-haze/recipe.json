{
  "id": "heat-haze",
  "name": "Heat Haze",
  "category": "shaders",
  "summary": "Distorsión térmica sobre bandas de luz con ruido temporal; sensación de aire caliente sin postproceso externo.",
  "tags": [
    "shader",
    "webgl",
    "calor",
    "distorsion",
    "aire"
  ],
  "engines": [
    "webgl",
    "glsl"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect heat-haze`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "amount",
      "type": "number",
      "default": 0.4,
      "description": "Amplitud de la distorsión",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "name": "intensity",
      "type": "number",
      "default": 0.7,
      "description": "Intensidad de las bandas",
      "min": 0.2,
      "max": 1.3,
      "step": 0.05
    }
  ]
}
