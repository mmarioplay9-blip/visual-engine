{
  "id": "dust-motes",
  "name": "Dust Motes",
  "category": "particulas",
  "summary": "Motas de polvo con deriva sinusoidal, profundidad simulada y halos suaves; atmósfera de interior cinematográfico.",
  "tags": [
    "particulas",
    "polvo",
    "atmosfera",
    "bokeh",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect dust-motes`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "count",
      "type": "number",
      "default": 110,
      "description": "Número de motas",
      "min": 20,
      "max": 240,
      "step": 1
    },
    {
      "name": "size",
      "type": "number",
      "default": 2.4,
      "description": "Tamaño base en px",
      "min": 0.5,
      "max": 8,
      "step": 0.1
    }
  ]
}
