{
  "id": "wave-contours",
  "name": "Wave Contours",
  "category": "fondos",
  "summary": "Curvas de nivel topográficas desplazadas por ruido; terreno abstracto con lectura de profundidad.",
  "tags": [
    "fondo",
    "contornos",
    "topografia",
    "ruido",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect wave-contours`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "lines",
      "type": "number",
      "default": 44,
      "description": "Número de curvas",
      "min": 12,
      "max": 90,
      "step": 1
    },
    {
      "name": "depth",
      "type": "number",
      "default": 0.6,
      "description": "Amplitud del terreno",
      "min": 0,
      "max": 1.5,
      "step": 0.05
    }
  ]
}
