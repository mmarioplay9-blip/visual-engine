{
  "id": "fractal-tunnel",
  "name": "Fractal Tunnel",
  "category": "shaders",
  "summary": "Túnel polar con ruido fractal, anillos de profundidad y deriva lateral; vuelo continuo en WebGL.",
  "tags": [
    "shader",
    "webgl",
    "tunel",
    "fractal",
    "profundidad"
  ],
  "engines": [
    "webgl",
    "glsl"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect fractal-tunnel`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "twist",
      "type": "number",
      "default": 0,
      "description": "Torsión del túnel",
      "min": -1,
      "max": 1,
      "step": 0.05
    },
    {
      "name": "intensity",
      "type": "number",
      "default": 0.85,
      "description": "Intensidad de anillos",
      "min": 0.2,
      "max": 1.3,
      "step": 0.05
    }
  ]
}
