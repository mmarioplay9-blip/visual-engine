{
  "id": "dolly-zoom",
  "name": "Dolly Zoom",
  "category": "camara",
  "summary": "Contra-zoom de vértigo: el fondo se comprime mientras el marco crece; efecto Hitchcock en 2D.",
  "tags": [
    "camara",
    "dolly",
    "zoom",
    "vertigo",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect dolly-zoom`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "intensity",
      "type": "number",
      "default": 0.8,
      "description": "Intensidad del contra-zoom",
      "min": 0.2,
      "max": 1.5,
      "step": 0.05
    }
  ]
}
