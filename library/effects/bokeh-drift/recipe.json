{
  "id": "bokeh-drift",
  "name": "Bokeh Drift",
  "category": "particulas",
  "summary": "Discos desenfocados de gran formato que se cruzan con mezcla aditiva; profundidad de campo abstracta.",
  "tags": [
    "particulas",
    "bokeh",
    "desenfoque",
    "profundidad",
    "canvas"
  ],
  "engines": [
    "canvas2d"
  ],
  "requires": [],
  "performance": "Pendiente de medición 0.3: ejecuta `ve benchmark --effect bokeh-drift`.",
  "license": "MIT (propio)",
  "entry": "index.html",
  "compatibility": {
    "chrome": ">=120",
    "firefox": ">=120",
    "safari": ">=17",
    "reducedMotion": "dibuja un fotograma estático",
    "dependencies": "ninguna"
  },
  "integration": {
    "mount": "mount(canvas, params)",
    "cleanup": "la función devuelta cancela el RAF y los listeners",
    "standalone": "index.html"
  },
  "params": [
    {
      "name": "bg",
      "type": "color",
      "default": "#05070d",
      "description": "Fondo base"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#12e0c8",
      "description": "Acento frío"
    },
    {
      "name": "accent2",
      "type": "color",
      "default": "#ffb454",
      "description": "Acento cálido"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Velocidad de la animación",
      "min": 0,
      "max": 4,
      "step": 0.05
    },
    {
      "name": "count",
      "type": "number",
      "default": 28,
      "description": "Cantidad de discos (referencia visual)",
      "min": 8,
      "max": 48,
      "step": 1
    }
  ]
}
